# PostgreSQL (used by docker-compose and the server)
POSTGRES_USER=safetext
POSTGRES_PASSWORD=safetext
POSTGRES_DB=safetext

# Server
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://safetext:safetext@localhost:5432/safetext

# Provider API keys (the running server reads these from server/.env)
LLM_WHISPERER_API_KEY=
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-8k
GOOGLE_SAFE_BROWSING_API_KEY=
