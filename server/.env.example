PORT=3001
# Set true on Render to serve the built frontend and API from one HTTPS address.
SERVE_WEB=false
# Finished scans are removed automatically. Oldest finished scans can expire sooner at capacity.
SCAN_RETENTION_DAYS=30
MAX_SCANS_PER_USER=100
MAX_STORED_SCANS=1000
MAX_PENDING_IMAGE_MB=32
AUDIT_RETENTION_DAYS=90
MAX_ACCOUNTS=500
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://safetext:safetext@localhost:5432/safetext

# Client identity: socket locally; render ONLY for a public Render web service.
# Render's edge overwrites CF-Connecting-IP. Do not enable unrestricted trust proxy.
CLIENT_IP_SOURCE=socket
# All limits below are optional. Fixed windows persist in PostgreSQL across deploys.
API_RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_IP=100
AUTH_RATE_LIMIT_PER_EMAIL=20
RESET_REQUESTS_PER_HOUR_PER_IP=20
RESET_REQUESTS_PER_HOUR_PER_EMAIL=5
RESET_VERIFY_PER_15_MIN_PER_IP=100
RESET_VERIFY_PER_15_MIN_PER_EMAIL=20
RESET_PASSWORD_ATTEMPTS_PER_MINUTE=5
RESET_RESEND_COOLDOWN_SECONDS=60
RESET_MAX_CODE_ATTEMPTS=8
# Admin settings override the scan default if an override has been saved.
SCAN_RATE_LIMIT_PER_15_MIN=20

# Provider API keys (server-side only; never expose them to the frontend)
LLM_WHISPERER_API_KEY=
# Match your LLMWhisperer account region (EU: llmwhisperer-api.eu-west.unstract.com).
LLM_WHISPERER_BASE_URL=https://llmwhisperer-api.us-central.unstract.com/api/v2
KIMI_API_KEY=
KIMI_MODEL=kimi-k3
GOOGLE_SAFE_BROWSING_API_KEY=

# Password-reset email: HTTPS is recommended for Render Free (standard SMTP ports are blocked).
# Create a Brevo API key and verify EMAIL_FROM in Brevo; keep the key server-side.
BREVO_API_KEY=
# Use your verified sender, for example SafeText <your-verified-address@gmail.com>.
# The .local default intentionally disables real email delivery until configured.
EMAIL_FROM=SafeText <no-reply@safetext.local>
# Optional SMTP for local development or a host allowing SMTP. HTTPS takes precedence.
SMTP_URL=
# Local only; logs synthetic test/reset email instead of delivering it. Ignored in production.
EMAIL_DEV_LOG=
